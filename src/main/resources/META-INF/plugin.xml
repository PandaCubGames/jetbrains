<idea-plugin>
    <id>pandacub.games.pandacub-dracula</id>
    <name>Pandacub Dracula</name>
    <vendor url="https://github.com/PandaCubGames/jetbrains">PandaCubGames</vendor>
    <depends>com.intellij.modules.lang</depends>
    <idea-version since-build="253"/>
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.draculatheme.jetbrains.settings.DraculaSettings"/>
        <postStartupActivity implementation="com.draculatheme.jetbrains.activities.DraculaStartupActivity"/>
        <notificationGroup displayType="STICKY_BALLOON" id="Pandacub Dracula" isLogByDefault="true"/>
        <themeProvider id="af6cea4f-67ab-5056-9ed8-b37c5ba2767b" path="/themes/Dracula.theme.json"/>
        <themeProvider id="3d18abbb-5296-5e73-a158-b636fb625c8a" path="/themes/DraculaColorful.theme.json"/>
        <themeProvider id="9977b081-e3ce-5e70-9cb0-219cac3bf13e" path="/themes/DraculaAlucard.theme.json"/>
        <themeProvider id="15c4cb0a-a3bd-54aa-8b76-81614bfc6a59" path="/themes/IslandsDracula.theme.json"/>
        <themeProvider id="40f8a3fd-0c36-56bb-81a3-5a0f9e7ca4a9" path="/themes/IslandsDraculaColorful.theme.json"/>
        <themeProvider id="ecf85a40-ff70-54e7-a64b-f85d3f55636e" path="/themes/IslandsDraculaAlucard.theme.json"/>
    </extensions>
</idea-plugin>
